{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window and the fullscreen effect overlay",
  "windows": ["main", "fx"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:allow-set-size",
    "core:window:allow-start-dragging",
    "core:window:allow-start-resize-dragging"
  ]
}
