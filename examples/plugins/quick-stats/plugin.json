{
  "api_version": 1,
  "id": "quick-stats",
  "name": "快速统计",
  "version": "1.0.0",
  "description": "计算一组数字的总和、平均值、最小值、最大值和中位数。无需宿主权限。",
  "author": "Shannon 示例",
  "entry": "main.js",
  "permissions": [],
  "tools": [{
    "name": "summarize",
    "description": "统计传入数字数组的数量、总和、平均值、最小值、最大值和中位数。",
    "effect": "read",
    "permissions": [],
    "parameters": {
      "type": "object",
      "properties": {"values": {"type": "array", "minItems": 1, "maxItems": 1000, "items": {"type": "number", "minimum": -1000000000000, "maximum": 1000000000000}}},
      "required": ["values"],
      "additionalProperties": false
    }
  }]
}
